<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!-- The minimal UI has no reason to ship the ICU CJK data (243KB brotli).
         Dates are rendered with fixed invariant-culture formats. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Timestamps are displayed as UTC only; drop the bundled timezone database. -->
    <InvariantTimezone>true</InvariantTimezone>

    <!-- Native-compile on publish. Without AOT the startup work (LIFF init, configuration
         binding, first renders) runs on the IL interpreter, which dominates the time from splash
         to first page render. AOT grows the download, which the immutable asset caching amortises
         to the first visit. Publish-only, so the inner dev loop stays fast. A mini app is opened
         from inside the LINE client where the runtime is often already cached, so this trade is
         favourable here (see SPEC 1 #6). -->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

</Project>
