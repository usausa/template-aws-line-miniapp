<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\..\Analyzers.ruleset</CodeAnalysisRuleSet>

    <AWSProjectType>Lambda</AWSProjectType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

    <!-- Deployed to the managed dotnet10 runtime as a plain publish output, so the whole
         template builds with the .NET SDK alone. Native AOT would cut cold starts further but
         needs a Linux cross-toolchain (in practice Docker), which the deploy scripts avoid. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Handler wrappers ([Lambda]/[HttpApi] + parameter binding + filter pipeline) are produced
         by the AmazonLambdaExtension source generator, which ships inside this single package.
         Unlike Amazon.Lambda.Annotations it emits no serverless.template, so no cleanup target
         is needed. -->
    <PackageReference Include="AmazonLambdaExtension" Version="2.0.0-beta8" />

    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
    <PackageReference Include="Amazon.Lambda.Core" Version="3.4.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.107.3" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.19" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Usa.Smart.Mapper" Version="1.0.0-beta14" />
  </ItemGroup>

</Project>
